---
import BaseLayout from "../layouts/BaseLayout.astro";
import { FONTS } from "../data/fonts";

// Compact client-side payload: only what the tool needs.
const compact = FONTS.map((f) => ({
  n: f.name,
  s: f.slug,
  c: f.category,
  se: f.serif,
  m: f.moods,
  p: f.popularity,
  w: f.weights,
}));
const fontJson = JSON.stringify(compact);
const vibes = ["elegant", "formal", "friendly", "playful", "bold", "modern", "vintage", "editorial"];

const title = "Font Identifier from Image — Free Visual Font Matcher";
const description =
  "Upload a screenshot and visually match it against popular fonts with this free font identifier from image tool. Everything runs in your browser — nothing is uploaded.";
---

<BaseLayout title={title} description={description} path="/font-identifier-from-image/">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
      Font Identifier from Image
    </h1>
    <p class="mt-4 max-w-3xl text-slate-600">
      Upload a screenshot or photo of text, then visually compare it side by side with popular
      fonts rendered in your own words. This is a visual matching aid — not automatic recognition —
      so you stay in control of the final call. Pick the candidate that looks closest to your image.
    </p>

    <!-- ============ STEP 1 : UPLOAD ============ -->
    <section class="mt-10">
      <div class="flex items-center gap-3">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white">1</span>
        <h2 class="text-xl font-bold text-slate-900">Upload your image</h2>
      </div>
      <div
        id="dropzone"
        class="mt-4 cursor-pointer rounded-xl border-2 border-dashed border-indigo-300 bg-indigo-50/50 p-8 text-center transition hover:border-indigo-500 hover:bg-indigo-50"
        role="button"
        tabindex="0"
        aria-label="Upload an image of text"
      >
        <input id="file-input" type="file" accept="image/*" class="hidden" />
        <p class="text-lg font-semibold text-slate-800">Drag &amp; drop your image here</p>
        <p class="mt-1 text-sm text-slate-500">or click to choose a file (JPG, PNG, WebP — any size)</p>
        <p class="mt-2 text-xs text-slate-400">Your image is processed locally and downscaled for display. It never leaves your device.</p>
      </div>
    </section>

    <!-- ============ STEP 2 : NARROW DOWN ============ -->
    <section class="mt-10">
      <div class="flex items-center gap-3">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white">2</span>
        <h2 class="text-xl font-bold text-slate-900">Narrow down the candidates <span class="text-sm font-normal text-slate-500">(optional)</span></h2>
      </div>
      <p class="mt-2 text-sm text-slate-500">
        Three quick questions about what you see in your image. Leave everything on "Skip" to
        compare against the 40 most popular fonts.
      </p>
      <div class="mt-4 grid gap-4 md:grid-cols-3">
        <label class="block rounded-xl border border-slate-200 bg-white p-4">
          <span class="text-sm font-semibold text-slate-800">Serifs?</span>
          <select id="filter-serif" class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none">
            <option value="skip">Skip — show everything</option>
            <option value="none">No serifs — clean stroke ends</option>
            <option value="slab">Slab serifs — thick blocky feet</option>
            <option value="serif">Thin / bracketed serifs</option>
          </select>
        </label>
        <label class="block rounded-xl border border-slate-200 bg-white p-4">
          <span class="text-sm font-semibold text-slate-800">Style?</span>
          <select id="filter-style" class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none">
            <option value="skip">Skip — show everything</option>
            <option value="plain">Plain — normal text look</option>
            <option value="handwritten">Handwriting / script</option>
            <option value="code">Code / typewriter</option>
            <option value="decorative">Decorative / poster</option>
          </select>
        </label>
        <label class="block rounded-xl border border-slate-200 bg-white p-4">
          <span class="text-sm font-semibold text-slate-800">Vibe?</span>
          <select id="filter-vibe" class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none">
            <option value="skip">Skip — show everything</option>
            {vibes.map((v) => (
              <option value={v}>{v.charAt(0).toUpperCase() + v.slice(1)}</option>
            ))}
          </select>
        </label>
      </div>
    </section>

    <!-- ============ STEP 3 : COMPARE ============ -->
    <section class="mt-10">
      <div class="flex items-center gap-3">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white">3</span>
        <h2 class="text-xl font-bold text-slate-900">Compare and find your match</h2>
      </div>

      <div class="mt-4 grid gap-6 lg:grid-cols-[340px_1fr]">
        <!-- Sticky reference panel -->
        <div class="lg:self-start">
          <div class="lg:sticky lg:top-24 rounded-xl border border-slate-200 bg-white p-4">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Your reference</h3>
            <div id="reference-placeholder" class="mt-3 flex max-h-80 min-h-48 items-center justify-center rounded-lg bg-slate-100 p-6 text-center">
              <p class="text-sm text-slate-500">Upload an image in Step 1 and it will stay pinned here while you compare.</p>
            </div>
            <div id="reference-panel" class="checkerboard mt-3 hidden items-center justify-center overflow-hidden rounded-lg">
              <img id="reference-img" alt="Your uploaded text reference" class="max-h-80 w-full object-contain" />
            </div>
          </div>
        </div>

        <!-- Controls + candidates -->
        <div>
          <div class="rounded-xl border border-slate-200 bg-white p-4">
            <label class="block">
              <span class="text-sm font-semibold text-slate-800">Type your own text</span>
              <input
                id="sample-text"
                type="text"
                value="The quick brown fox jumps over the lazy dog"
                class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none"
              />
            </label>
            <label class="mt-4 block">
              <span class="text-sm font-semibold text-slate-800">Font size: <span id="size-label">48</span>px</span>
              <input id="font-size" type="range" min="24" max="96" value="48" class="mt-2 w-full accent-indigo-600" />
            </label>
            <p id="result-count" class="mt-3 text-sm text-slate-500"></p>
          </div>

          <div id="candidates" class="mt-4 grid gap-4 sm:grid-cols-2"></div>
        </div>
      </div>
    </section>

    <!-- ============ TIPS ============ -->
    <section class="mt-12 rounded-xl bg-slate-50 p-6">
      <h2 class="text-xl font-bold text-slate-900">Tips for best results</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-slate-600">
        <li>Use a straight-on, high-contrast screenshot — avoid angled photos with shadows.</li>
        <li>One line of text works best; crop out logos, backgrounds and other fonts first.</li>
        <li>Type the exact letters from your image into the sample box for a letter-by-letter comparison.</li>
        <li>Zoom the size slider up to compare fine details like serifs, the letter "g", or stroke contrast.</li>
      </ul>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="mt-10">
      <h2 class="text-xl font-bold text-slate-900">Frequently asked questions</h2>
      <div class="mt-4 space-y-3">
        <details class="rounded-xl border border-slate-200 bg-white p-4">
          <summary class="cursor-pointer font-semibold text-slate-800">How accurate is it?</summary>
          <p class="mt-2 text-sm text-slate-600">
            It depends on you visually matching your image against the rendered candidates — the tool
            narrows the field, you make the final call. It works best with clear, straight-on
            screenshots of a single font. It only compares against the 148 popular fonts in our
            library, so rare or commercial fonts may not appear.
          </p>
        </details>
        <details class="rounded-xl border border-slate-200 bg-white p-4">
          <summary class="cursor-pointer font-semibold text-slate-800">Does my image get uploaded to a server?</summary>
          <p class="mt-2 text-sm text-slate-600">
            No. Everything runs in your browser — your image is processed locally on your device and
            never sent anywhere. Font previews load from Google Fonts' public CDN, which is the only
            network request the tool makes.
          </p>
        </details>
        <details class="rounded-xl border border-slate-200 bg-white p-4">
          <summary class="cursor-pointer font-semibold text-slate-800">What image works best?</summary>
          <p class="mt-2 text-sm text-slate-600">
            A straight-on screenshot with high contrast between text and background, showing a single
            line of text. Large, sharp lettering is easier to match than small or blurry text, and
            images with just one font give cleaner comparisons than mixed-type layouts.
          </p>
        </details>
        <details class="rounded-xl border border-slate-200 bg-white p-4">
          <summary class="cursor-pointer font-semibold text-slate-800">Is it free?</summary>
          <p class="mt-2 text-sm text-slate-600">
            Yes — the tool is completely free with no sign-up, and every candidate font is a free
            Google Font you can use in your own projects.
          </p>
        </details>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="mt-12 grid gap-4 md:grid-cols-2">
      <a href="/identify/" class="rounded-xl border border-indigo-200 bg-indigo-50 p-6 transition hover:border-indigo-400">
        <h3 class="font-bold text-slate-900">Not sure? Try the Q&amp;A finder</h3>
        <p class="mt-1 text-sm text-slate-600">Answer five questions about the font's look and get ranked matches.</p>
      </a>
      <a href="/browse/" class="rounded-xl border border-slate-200 bg-white p-6 transition hover:border-indigo-400">
        <h3 class="font-bold text-slate-900">Browse all 148 fonts</h3>
        <p class="mt-1 text-sm text-slate-600">Explore the full library by category, mood and style.</p>
      </a>
    </section>
  </div>

  <script id="font-data" type="application/json">{fontJson}</script>

  <script>
    (function () {
      var FONTS = JSON.parse(document.getElementById("font-data").textContent || "[]");
      var CATEGORY_LABELS = {
        serif: "Serif",
        "sans-serif": "Sans-Serif",
        display: "Display",
        handwritten: "Handwritten",
        monospace: "Monospace",
      };

      var serifSel = document.getElementById("filter-serif");
      var styleSel = document.getElementById("filter-style");
      var vibeSel = document.getElementById("filter-vibe");
      var sampleInput = document.getElementById("sample-text");
      var sizeInput = document.getElementById("font-size");
      var sizeLabel = document.getElementById("size-label");
      var grid = document.getElementById("candidates");
      var countLine = document.getElementById("result-count");

      /* ---------- filtering ---------- */
      function currentList() {
        var serif = serifSel.value;
        var style = styleSel.value;
        var vibe = vibeSel.value;
        var list = FONTS.slice();

        if (serif === "none") list = list.filter(function (f) { return f.se === "none"; });
        else if (serif === "slab") list = list.filter(function (f) { return f.se === "slab"; });
        else if (serif === "serif")
          list = list.filter(function (f) {
            return f.se === "bracketed" || f.se === "modern" || f.se === "oldstyle";
          });

        if (style === "plain") list = list.filter(function (f) { return f.c === "serif" || f.c === "sans-serif"; });
        else if (style === "handwritten") list = list.filter(function (f) { return f.c === "handwritten"; });
        else if (style === "code") list = list.filter(function (f) { return f.c === "monospace"; });
        else if (style === "decorative") list = list.filter(function (f) { return f.c === "display"; });

        if (vibe !== "skip") list = list.filter(function (f) { return f.m.indexOf(vibe) !== -1; });

        list.sort(function (a, b) { return b.p - a.p; });
        return list.slice(0, 40);
      }

      /* ---------- webfont loading ---------- */
      function loadWebfonts(list) {
        var fams = list.map(function (f) {
          var wt = f.w.indexOf(400) !== -1 ? 400 : f.w[0];
          return "family=" + f.n.replace(/ /g, "+") + ":wght@" + wt;
        });
        var url = "https://fonts.googleapis.com/css2?" + fams.join("&") + "&display=swap";
        var link = document.getElementById("candidate-fonts");
        if (!link) {
          link = document.createElement("link");
          link.id = "candidate-fonts";
          link.rel = "stylesheet";
          document.head.appendChild(link);
        }
        link.href = url;
      }

      /* ---------- rendering ---------- */
      function render() {
        var list = currentList();
        loadWebfonts(list);

        var text = sampleInput.value.trim() || "The quick brown fox jumps over the lazy dog";
        var px = parseInt(sizeInput.value, 10) || 48;
        sizeLabel.textContent = String(px);

        countLine.textContent =
          list.length === 0
            ? "No fonts match those filters — try loosening one of them."
            : "Showing " + list.length + " candidate font" + (list.length === 1 ? "" : "s") + ". Compare each against your reference image.";

        grid.innerHTML = "";
        list.forEach(function (f) {
          var card = document.createElement("div");
          card.className = "rounded-xl border border-slate-200 bg-white p-4";

          var head = document.createElement("div");
          head.className = "flex items-baseline justify-between gap-2";

          var name = document.createElement("p");
          name.className = "font-bold text-slate-900";
          name.textContent = f.n;

          var cat = document.createElement("span");
          cat.className = "shrink-0 rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700";
          cat.textContent = CATEGORY_LABELS[f.c] || f.c;

          head.appendChild(name);
          head.appendChild(cat);

          var sample = document.createElement("p");
          sample.className = "mt-3 break-words leading-snug text-slate-800";
          sample.style.fontFamily = "'" + f.n + "', sans-serif";
          sample.style.fontSize = px + "px";
          sample.textContent = text;

          var link = document.createElement("a");
          link.className = "mt-3 inline-block text-sm font-semibold text-indigo-600 hover:text-indigo-800";
          link.href = "/fonts/" + f.s + "/";
          link.textContent = "View details";

          card.appendChild(head);
          card.appendChild(sample);
          card.appendChild(link);
          grid.appendChild(card);
        });
      }

      serifSel.addEventListener("change", render);
      styleSel.addEventListener("change", render);
      vibeSel.addEventListener("change", render);
      sampleInput.addEventListener("input", render);
      sizeInput.addEventListener("input", render);

      /* ---------- upload ---------- */
      var dropzone = document.getElementById("dropzone");
      var fileInput = document.getElementById("file-input");
      var placeholder = document.getElementById("reference-placeholder");
      var panel = document.getElementById("reference-panel");
      var refImg = document.getElementById("reference-img");

      function handleFile(file) {
        if (!file || file.type.indexOf("image/") !== 0) return;
        var objectUrl = URL.createObjectURL(file);
        var img = new Image();
        img.onload = function () {
          var max = 1600;
          var w = img.naturalWidth;
          var h = img.naturalHeight;
          if (w > max || h > max) {
            var r = Math.min(max / w, max / h);
            w = Math.round(w * r);
            h = Math.round(h * r);
          }
          var canvas = document.createElement("canvas");
          canvas.width = w;
          canvas.height = h;
          var ctx = canvas.getContext("2d");
          if (ctx) ctx.drawImage(img, 0, 0, w, h);
          refImg.src = canvas.toDataURL("image/png");
          URL.revokeObjectURL(objectUrl);
          placeholder.classList.add("hidden");
          panel.classList.remove("hidden");
          panel.classList.add("flex");
        };
        img.src = objectUrl;
      }

      dropzone.addEventListener("click", function () { fileInput.click(); });
      dropzone.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          fileInput.click();
        }
      });
      fileInput.addEventListener("change", function () {
        if (fileInput.files && fileInput.files[0]) handleFile(fileInput.files[0]);
        fileInput.value = "";
      });
      ["dragenter", "dragover"].forEach(function (evt) {
        dropzone.addEventListener(evt, function (e) {
          e.preventDefault();
          dropzone.classList.add("border-indigo-500", "bg-indigo-100");
        });
      });
      ["dragleave", "drop"].forEach(function (evt) {
        dropzone.addEventListener(evt, function (e) {
          e.preventDefault();
          dropzone.classList.remove("border-indigo-500", "bg-indigo-100");
        });
      });
      dropzone.addEventListener("drop", function (e) {
        var dt = e.dataTransfer;
        if (dt && dt.files && dt.files[0]) handleFile(dt.files[0]);
      });

      render();
    })();
  </script>

  <style>
    .checkerboard {
      background-color: #1e293b;
      background-image:
        linear-gradient(45deg, #334155 25%, transparent 25%, transparent 75%, #334155 75%),
        linear-gradient(45deg, #334155 25%, transparent 25%, transparent 75%, #334155 75%);
      background-size: 20px 20px;
      background-position: 0 0, 10px 10px;
      min-height: 12rem;
    }
  </style>
</BaseLayout>
