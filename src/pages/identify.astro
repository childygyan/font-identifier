---
import BaseLayout from "../layouts/BaseLayout.astro";
import { WIZARD_QUESTIONS, FONTS, CATEGORY_LABELS } from "../data/fonts.js";

const title = "Font Finder Quiz — Answer 5 Questions, Find Your Font";
const description =
  "Answer five quick questions about the font you saw and get ranked matches from 148 popular free fonts. Free font finder quiz — no sign-up needed.";

interface CompactFont {
  slug: string;
  name: string;
  category: string;
  serif: string;
  contrast: string;
  weight: string;
  xHeight: string;
  moods: string[];
  weights: number[];
  popularity: number;
}

const compactFonts: CompactFont[] = FONTS.map((f) => ({
  slug: f.slug,
  name: f.name,
  category: f.category,
  serif: f.serif,
  contrast: f.contrast,
  weight: f.weight,
  xHeight: f.xHeight,
  moods: f.moods,
  weights: f.weights,
  popularity: f.popularity,
}));

const questionsJson = JSON.stringify(WIZARD_QUESTIONS);
const fontsJson = JSON.stringify(compactFonts);
const labelsJson = JSON.stringify(CATEGORY_LABELS);
---

<BaseLayout title={title} description={description} path="/identify/">
  <section class="mx-auto max-w-3xl px-4 pt-12">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
      Find Your Font — 5 Questions
    </h1>
    <p class="mt-3 text-lg text-slate-600">
      Saw a font you like but don't know its name? Describe what it looks like and we'll
      match your answers against <strong class="font-semibold text-slate-800">148 popular free fonts</strong>,
      ranked by how closely they fit.
    </p>

    <div id="quiz-wrap" class="mt-8">
      <noscript>
        <p class="rounded-xl border border-slate-200 bg-slate-50 p-6 text-slate-600">
          This quiz needs JavaScript to run. Please enable JavaScript and reload the page.
        </p>
      </noscript>
    </div>
  </section>

  <section id="results-wrap" class="mx-auto hidden max-w-6xl px-4 pt-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">Your top matches</h2>
        <p class="mt-1 text-sm text-slate-500">
          Ranked by how well each font fits your answers. Click a name to see full details.
        </p>
      </div>
      <button
        id="start-over-top"
        class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:border-indigo-400 hover:text-indigo-700"
      >
        Start over
      </button>
    </div>

    <div class="mt-5 flex flex-col gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 sm:flex-row sm:items-center">
      <input
        id="preview-text"
        type="text"
        maxlength="80"
        placeholder="Type your own text to preview the matches…"
        class="flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none"
      />
      <label class="flex items-center gap-2 text-sm font-medium text-slate-600">
        Size
        <input id="preview-size" type="range" min="16" max="64" value="28" class="w-32 accent-indigo-600" />
        <span id="size-val" class="w-12 text-right tabular-nums text-slate-500">28px</span>
      </label>
    </div>

    <div id="results-grid" class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>

    <div class="mt-10 text-center">
      <button
        id="start-over-bottom"
        class="rounded-lg bg-indigo-600 px-6 py-3 text-sm font-semibold text-white hover:bg-indigo-700"
      >
        Retake the quiz
      </button>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pt-14">
    <h2 class="text-xl font-extrabold tracking-tight text-slate-900">Other ways to identify a font</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <a
        href="/font-identifier-from-image/"
        class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-indigo-400 hover:shadow"
      >
        <h3 class="font-bold text-slate-900">Have a picture of the font?</h3>
        <p class="mt-1 text-sm text-slate-600">
          Upload an image and compare it side-by-side with fonts rendered in your browser.
        </p>
        <span class="mt-3 inline-block text-sm font-semibold text-indigo-600">Identify from image →</span>
      </a>
      <a
        href="/browse/"
        class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-indigo-400 hover:shadow"
      >
        <h3 class="font-bold text-slate-900">Just exploring?</h3>
        <p class="mt-1 text-sm text-slate-600">
          Browse all 148 fonts with live previews, filters by category, mood and more.
        </p>
        <span class="mt-3 inline-block text-sm font-semibold text-indigo-600">Browse the library →</span>
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pt-12">
    <h2 class="text-xl font-extrabold tracking-tight text-slate-900">Frequently asked questions</h2>
    <div class="mt-4 space-y-4">
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-900">How does the quiz work?</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          You answer five questions about the font's appearance — serifs, style, stroke contrast,
          weight and overall vibe. The quiz compares your answers against the recorded traits of
          148 popular free fonts and ranks the closest matches. This is guided trait matching,
          not AI image recognition — no picture analysis happens here.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-900">What if my font isn't listed?</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          The library covers 148 of the most popular free fonts, so most everyday sightings are
          included. If none of the matches look right, try the
          <a href="/font-identifier-from-image/" class="font-semibold text-indigo-600 hover:text-indigo-800">image comparison tool</a>
          — upload your picture and compare it visually against rendered fonts side-by-side.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-900">Is it free?</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          Yes. The quiz, all matches and every font in the library are completely free, with no
          sign-up needed. All 148 fonts are free Google Fonts you can use in your own projects.
        </p>
      </div>
    </div>
  </section>

  <script type="application/json" id="wizard-questions" set:html={questionsJson} />
  <script type="application/json" id="wizard-fonts" set:html={fontsJson} />
  <script type="application/json" id="wizard-labels" set:html={labelsJson} />

  <script>
    (function () {
      var QUESTIONS = JSON.parse(document.getElementById("wizard-questions").textContent || "[]");
      var FONT_LIST = JSON.parse(document.getElementById("wizard-fonts").textContent || "[]");
      var LABELS = JSON.parse(document.getElementById("wizard-labels").textContent || "{}");
      var PANGRAM = "The quick brown fox jumps over the lazy dog";

      var quizWrap = document.getElementById("quiz-wrap");
      var resultsWrap = document.getElementById("results-wrap");
      var resultsGrid = document.getElementById("results-grid");

      var step = "start"; // "start" | question index (number) | "results"
      var answers = {};

      // Faithful port of scoreWizard() from src/data/fonts.ts
      function scoreWizard(answers, fonts) {
        var results = [];
        for (var i = 0; i < fonts.length; i++) {
          var font = fonts[i];
          var points = 0;
          var max = 0;

          // Q1 serif
          var serifAns = answers["serif"];
          if (serifAns && serifAns !== "unsure") {
            max += 3;
            if (serifAns === "none" && font.serif === "none") points += 3;
            else if (serifAns === "slab" && font.serif === "slab") points += 3;
            else if (
              serifAns === "serif" &&
              (font.serif === "bracketed" || font.serif === "modern" || font.serif === "oldstyle")
            )
              points += 3;
          }

          // Q2 style -> category
          var styleAns = answers["style"];
          if (styleAns && styleAns !== "plain") {
            max += 4;
            if (styleAns === font.category) points += 4;
            else if (styleAns === "display" && font.category === "serif" && font.weight !== "regular")
              points += 1;
          } else if (styleAns === "plain") {
            max += 2;
            if (font.category === "serif" || font.category === "sans-serif") points += 2;
          }

          // Q3 contrast
          var contrastAns = answers["contrast"];
          if (contrastAns && contrastAns !== "unsure") {
            max += 2;
            if (contrastAns === font.contrast) points += 2;
            else if (contrastAns === "low" && font.contrast === "medium") points += 1;
            else if (contrastAns === "high" && font.contrast === "medium") points += 1;
          }

          // Q4 weight
          var weightAns = answers["weight"];
          if (weightAns) {
            max += 2;
            if (weightAns === font.weight) points += 2;
            else if (
              (weightAns === "light" && font.weight === "regular") ||
              (weightAns === "regular" && (font.weight === "light" || font.weight === "bold")) ||
              (weightAns === "bold" && (font.weight === "regular" || font.weight === "black")) ||
              (weightAns === "black" && font.weight === "bold")
            )
              points += 1;
          }

          // Q5 mood
          var moodAns = answers["mood"];
          if (moodAns) {
            max += 2;
            if (font.moods.indexOf(moodAns) !== -1) points += 2;
          }

          if (max > 0) {
            var normalized = Math.round((points / max) * 100);
            results.push({
              font: font,
              score: Math.min(99, normalized + Math.round(font.popularity / 100)),
            });
          }
        }
        results.sort(function (a, b) {
          return b.score - a.score || b.font.popularity - a.font.popularity;
        });
        return results;
      }

      function esc(s) {
        return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }

      function renderStart() {
        resultsWrap.classList.add("hidden");
        quizWrap.innerHTML =
          '<div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">' +
          '<p class="text-slate-600">Five quick questions about serifs, style, weight and vibe. ' +
          "Your answers are matched against 148 fonts — no upload needed.</p>" +
          '<button id="wiz-start" class="mt-6 rounded-lg bg-indigo-600 px-8 py-3 font-semibold text-white hover:bg-indigo-700">Start the quiz</button>' +
          '<p class="mt-4 text-sm text-slate-500">Takes about 30 seconds · Free · No sign-up</p>' +
          "</div>";
        document.getElementById("wiz-start").addEventListener("click", function () {
          step = 0;
          render();
        });
      }

      function renderQuestion(idx) {
        var q = QUESTIONS[idx];
        var canSkip = q.options.some(function (o) {
          return o.value === "unsure";
        });
        var pct = Math.round(((idx + 1) / QUESTIONS.length) * 100);

        var html =
          '<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">' +
          '<div class="flex items-center justify-between text-sm font-medium text-slate-500">' +
          "<span>Question " + (idx + 1) + " of " + QUESTIONS.length + "</span>" +
          "<span>" + pct + "%</span>" +
          "</div>" +
          '<div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100">' +
          '<div class="h-full rounded-full bg-indigo-600 transition-all" style="width:' + pct + '%"></div>' +
          "</div>" +
          '<h2 class="mt-5 text-xl font-bold text-slate-900 sm:text-2xl">' + esc(q.question) + "</h2>" +
          (q.hint ? '<p class="mt-1 text-sm text-slate-500">' + esc(q.hint) + "</p>" : "") +
          '<div class="mt-6 space-y-3">';

        q.options.forEach(function (o) {
          html +=
            '<button type="button" data-value="' + esc(o.value) + '" class="wiz-opt w-full rounded-xl border border-slate-200 px-4 py-3 text-left transition hover:border-indigo-400 hover:bg-indigo-50">' +
            '<span class="block font-semibold text-slate-900">' + esc(o.label) + "</span>" +
            (o.blurb ? '<span class="block text-sm text-slate-500">' + esc(o.blurb) + "</span>" : "") +
            "</button>";
        });

        html +=
          "</div>" +
          '<div class="mt-6 flex items-center justify-between">' +
          '<button type="button" id="wiz-back" class="text-sm font-semibold text-slate-500 hover:text-slate-800">&larr; Back</button>' +
          (canSkip
            ? '<button type="button" id="wiz-skip" class="text-sm font-semibold text-indigo-600 hover:text-indigo-800">Skip &rarr;</button>'
            : "<span></span>") +
          "</div>" +
          "</div>";

        quizWrap.innerHTML = html;

        var opts = quizWrap.querySelectorAll(".wiz-opt");
        opts.forEach(function (btn) {
          btn.addEventListener("click", function () {
            answers[q.id] = btn.getAttribute("data-value") || "";
            step = idx + 1 >= QUESTIONS.length ? "results" : idx + 1;
            render();
          });
        });

        document.getElementById("wiz-back").addEventListener("click", function () {
          step = idx === 0 ? "start" : idx - 1;
          render();
        });

        var skipBtn = document.getElementById("wiz-skip");
        if (skipBtn) {
          skipBtn.addEventListener("click", function () {
            answers[q.id] = "unsure";
            step = idx + 1 >= QUESTIONS.length ? "results" : idx + 1;
            render();
          });
        }
      }

      function loadResultFonts(top) {
        var fams = top.map(function (r) {
          return "family=" + r.font.name.replace(/ /g, "+") + ":wght@" + r.font.weights.join(";");
        });
        var link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = "https://fonts.googleapis.com/css2?" + fams.join("&") + "&display=swap";
        document.head.appendChild(link);
      }

      function cardHTML(r) {
        var f = r.font;
        var fam = "'" + f.name + "', sans-serif";
        var moods = f.moods
          .slice(0, 3)
          .map(function (m) {
            return '<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">' + esc(m) + "</span>";
          })
          .join("");
        return (
          '<article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">' +
          '<div class="flex items-center justify-between gap-2">' +
          '<span class="rounded-full bg-indigo-600 px-2.5 py-1 text-xs font-bold text-white">' + r.score + "% match</span>" +
          '<span class="text-xs font-semibold uppercase tracking-wide text-slate-400">' + esc(LABELS[f.category] || f.category) + "</span>" +
          "</div>" +
          '<h3 class="mt-4 text-2xl text-slate-900" style="font-family:' + fam + '">' + esc(f.name) + "</h3>" +
          '<p class="font-preview mt-2 leading-snug text-slate-700" style="font-family:' + fam + ';font-size:28px">' + esc(PANGRAM) + "</p>" +
          '<div class="mt-3 flex flex-wrap gap-1.5">' + moods + "</div>" +
          '<div class="mt-auto pt-4">' +
          '<a href="/fonts/' + esc(f.slug) + '/" class="text-sm font-semibold text-indigo-600 hover:text-indigo-800">View details &rarr;</a>' +
          "</div>" +
          "</article>"
        );
      }

      function updatePreviews() {
        var textInput = document.getElementById("preview-text");
        var sizeInput = document.getElementById("preview-size");
        var t = (textInput.value || "").trim() || PANGRAM;
        var s = sizeInput.value + "px";
        document.querySelectorAll(".font-preview").forEach(function (el) {
          el.textContent = t;
          el.style.fontSize = s;
        });
        document.getElementById("size-val").textContent = s;
      }

      function renderResults() {
        var top = scoreWizard(answers, FONT_LIST).slice(0, 12);
        loadResultFonts(top);
        resultsGrid.innerHTML = top.map(cardHTML).join("");
        quizWrap.innerHTML = "";
        resultsWrap.classList.remove("hidden");
        resultsWrap.scrollIntoView({ behavior: "smooth", block: "start" });

        var textInput = document.getElementById("preview-text");
        var sizeInput = document.getElementById("preview-size");
        textInput.value = "";
        sizeInput.value = "28";
        textInput.addEventListener("input", updatePreviews);
        sizeInput.addEventListener("input", updatePreviews);

        document.getElementById("start-over-top").addEventListener("click", reset);
        document.getElementById("start-over-bottom").addEventListener("click", reset);
      }

      function reset() {
        answers = {};
        step = "start";
        window.scrollTo({ top: 0, behavior: "smooth" });
        render();
      }

      function render() {
        if (step === "start") renderStart();
        else if (step === "results") renderResults();
        else renderQuestion(step);
      }

      render();
    })();
  </script>
</BaseLayout>
